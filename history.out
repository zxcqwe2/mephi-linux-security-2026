   1  sudo groupadd students
   2  sudo useradd -m -u 1234 -G students -s /bin/bash user1
   3  sudo passwd user1
   4  sudo chage -M 90 user1
   5  sudo find / -type f -perm -4000 2>/dev/null 
   6  ps -eo euid,ruid,pid,user,comm | awk '$1==0 && $2>=1000'
   7  mkdir hw
   8  ps -eo euid,ruid,pid,user,comm | awk '$1==0 && $2>=1000' > ~/hw/suid-files.out
   9  cat ~/hw/suid-files.out 
  10  sudo find / -type f -perm -4000 2>/dev/null > ~/hw/suid-files2.out
  11  cat ~/hw/suid-files2.out 
  12  sudo cp /bin/cat /home/user1/testcat
  13  sudo chown root:root /home/user1/testcat 
  14  sudo chmod u+s /home/user1/testcat 
  15  ls -l /home/user1/testcat 
  16  sudo cp /bin/chown /home/user1/testchown
  17  sudo setcap cap_chown+ep /home/user1/testchown 
  18  /usr/sbin/getcap /home/user1/testchown 
  19  timedatectl
  20  sudo timedatectl set-ntp false
  21  timedatectl
  22  sudo visudo -f /etc/sudoers.d/newtime
  23  sudo visudo -f /etc/sudoers.d/user1-time
